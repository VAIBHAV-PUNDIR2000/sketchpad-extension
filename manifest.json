{
  "manifest_version": 3,
  "name": "Scratchpad for AI Chats",
  "version": "1.0.0",
  "description": "Sketch a quick diagram next to the message box and attach it to your prompt. Works with Claude, ChatGPT and Gemini.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/pad-css.js",
        "src/pad-icons.js",
        "src/pad-ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/inject-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
